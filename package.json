{
  "name": "dsh-finish-reminder",
  "version": "0.3.1",
  "private": true,
  "description": "Local task-end reminders for DeepSeek Harness; capability-gated Windows desktop integration.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native/Reminder.exe",
    "native/Reminder.exe.manifest",
    "cordis.patch.yml",
    "README.md",
    "MANUAL-ACCEPTANCE.md",
    "desktop-adapters.md",
    "LICENSE",
    "CHANGELOG.md",
    "task-receipt-ui-v0.3.0-development.md",
    "docs/images"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.3"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test && node scripts/check-receipt-visual.mjs && node scripts/check-package.mjs",
    "probe:host": "node scripts/probe-host.mjs",
    "probe:native": "node scripts/probe-native.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "package": "node scripts/package-preview.mjs",
    "check:receipt": "node scripts/check-receipt-visual.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "probe:compatibility": "node scripts/probe-compatibility.mjs"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xian-JL/dsh-finish-reminder.git"
  },
  "homepage": "https://github.com/Xian-JL/dsh-finish-reminder#readme",
  "bugs": {
    "url": "https://github.com/Xian-JL/dsh-finish-reminder/issues"
  }
}
